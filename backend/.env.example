# Server
PORT=5000
NODE_ENV=development

# PostgreSQL
# Local dev: fill in the discrete fields below.
# Hosted (Render/Railway/Neon/Supabase): set DATABASE_URL instead —
# when present it takes priority and the DB_* fields below are ignored.
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DB_HOST=localhost
DB_PORT=5432
DB_NAME=securedocchain
DB_USER=securedocchain_user
DB_PASSWORD=your_db_password_here

# JWT
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=1ds